# start-demo.ps1 sets BOLO_OFFLINE=1 to disable every hosted provider.
# All keys are optional. Missing ones fall back automatically (see docs/ai-stack.md).
# Speech (STT/TTS/translate/vision) — https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Second STT engine + LLM fallback — https://console.groq.com
GROQ_API_KEY=
# Agent LLM + third STT engine — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# LLM_ORDER=gemini,sarvam,groq

# Channel option A: Meta WhatsApp Cloud API test number (docs/setup-whatsapp.md)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=bolo-verify
WA_APP_SECRET=

# Channel option B: Twilio WhatsApp sandbox (used only if option A is empty)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=whatsapp:+14155238886

# Phone-call escalation (optional) — https://bolna.ai
BOLNA_API_KEY=
BOLNA_AGENT_ID=

# Public URL of the separate webhook gateway (see docs/setup-whatsapp.md).
PUBLIC_BASE_URL=http://localhost:8000
